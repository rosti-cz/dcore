#!/usr/bin/python3
"""Grow final GPT roots; resize LUKS2 partitions before unlocking, filesystems after."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile


class Skip(Exception):
    pass


def log(message):
    print(f"dcore-grow-root: {message}", flush=True)


def command(*args, allowed=(0,)):
    result = subprocess.run(args, text=True, capture_output=True, check=False)
    if result.returncode not in allowed:
        raise RuntimeError(f"{' '.join(args)} exited {result.returncode}: {result.stderr.strip()} {result.stdout.strip()}")
    return result


def table(disk):
    data = json.loads(command("sfdisk", "--json", disk).stdout)["partitiontable"]
    if data.get("label") != "gpt" or data.get("unit") != "sectors":
        raise Skip("root disk does not have a supported GPT partition table")
    return data


def device_id(device):
    value = os.stat(device)
    if not stat.S_ISBLK(value.st_mode):
        raise Skip(f"{device} is not a block device")
    return value.st_rdev


def root_device(mount):
    source = mount["source"].split("[", 1)[0]
    if source.startswith("/dev/") and os.path.exists(source):
        return os.path.realpath(source)
    # /dev/root may disappear after switch-root. Btrfs's anonymous mount device
    # cannot use this fallback, so it must have a resolvable source above.
    candidate = f"/dev/block/{mount['maj:min']}"
    if os.path.exists(candidate):
        return os.path.realpath(candidate)
    raise Skip("cannot resolve the root filesystem's backing block device")


def layout(disk, root):
    data = table(disk)
    partitions = sorted(data.get("partitions", []), key=lambda p: p["start"])
    root_id = device_id(root)
    matches = [p for p in partitions if device_id(p["node"]) == root_id]
    if len(matches) != 1 or not partitions:
        raise Skip("root partition cannot be identified unambiguously")
    previous_end = 0
    sectorsize = int(data["sectorsize"])
    disk_size = int(command("blockdev", "--getsize64", disk).stdout)
    for partition in partitions:
        start, size = int(partition["start"]), int(partition["size"])
        if start < previous_end or start <= 0 or size <= 0 or (start + size) * sectorsize > disk_size:
            raise Skip("partition table has overlapping or out-of-bounds entries")
        previous_end = start + size
    if matches[0] != partitions[-1]:
        raise Skip("root is not the physically last partition; leaving disk unchanged")
    return data, matches[0], disk_size


def btrfs_device(mountpoint, root):
    output = command("btrfs", "filesystem", "show", "--raw", mountpoint).stdout
    total = re.search(r"Total devices\s+(\d+)", output)
    devices = re.findall(r"devid\s+(\d+)\s+size\s+(\d+).*?\spath\s+(.+)", output)
    if not total or int(total[1]) != 1 or len(devices) != 1:
        raise Skip("multi-device or incomplete Btrfs filesystem is unsupported")
    devid, size, path = devices[0]
    if device_id(path.strip()) != device_id(root):
        raise Skip("Btrfs device does not match the root partition")
    if int(size) > int(command("blockdev", "--getsize64", root).stdout):
        raise Skip("Btrfs filesystem exceeds partition size; refusing possible shrink")
    return devid


def partition_parent(root, holder=None):
    identity = device_id(root)
    node = Path(f"/sys/dev/block/{os.major(identity)}:{os.minor(identity)}").resolve(strict=True)
    if not (node / "partition").is_file():
        raise Skip("root is not a supported partition")
    number = (node / "partition").read_text().strip()
    disk = f"/dev/{node.parent.name}"
    if command("lsblk", "--nodeps", "--noheadings", "--output", "TYPE", disk).stdout.strip() not in ("disk", "loop"):
        raise Skip("unsupported parent device type")
    holders = [p.name for p in (node / "holders").iterdir()]
    if holders != ([] if holder is None else [holder]):
        raise Skip("root partition has unexpected layered device holders")
    return disk, number


def luks_metadata(partition):
    if command("cryptsetup", "isLuks", "--type", "luks2", partition, allowed=(0, 1)).returncode:
        raise Skip("root is not an inline LUKS2 volume")
    metadata = json.loads(command("cryptsetup", "luksDump", "--dump-json-metadata", partition).stdout)
    segments = list(metadata.get("segments", {}).values())
    if (len(segments) != 1 or segments[0].get("type") != "crypt"
            or segments[0].get("size") != "dynamic" or segments[0].get("integrity")
            or segments[0].get("flags") or metadata.get("config", {}).get("requirements", {}).get("mandatory")):
        raise Skip("LUKS2 integrity, reencryption or fixed-size segments are unsupported")
    return segments[0]


def backing_partition(root):
    identity = device_id(root)
    node = Path(f"/sys/dev/block/{os.major(identity)}:{os.minor(identity)}").resolve(strict=True)
    if (node / "partition").is_file():
        return root, None
    if not (node / "dm/uuid").is_file():
        raise Skip("whole devices, LVM and RAID are unsupported")
    dm_uuid = (node / "dm/uuid").read_text().strip()
    match = re.fullmatch(r"CRYPT-LUKS2-([0-9a-fA-F]{32})-.+", dm_uuid)
    slaves = list((node / "slaves").iterdir())
    if not match or len(slaves) != 1:
        raise Skip("root is not a direct single-device LUKS2 mapping")
    partition = f"/dev/{slaves[0].name}"
    partition_parent(partition, node.name)
    if command("cryptsetup", "luksUUID", partition).stdout.strip().replace("-", "").lower() != match[1].lower():
        raise Skip("active mapping does not match the LUKS2 header UUID")
    segment = luks_metadata(partition)
    size = int(command("blockdev", "--getsize64", partition).stdout)
    offset, sector = int(segment["offset"]), int(segment["sector_size"])
    expected = ((size - offset) // sector) * sector
    actual = int(command("blockdev", "--getsize64", root).stdout)
    if actual != expected:
        raise Skip("LUKS mapping does not fill its partition; reboot to reopen it at full size")
    return partition, node.name


def grow_partition(disk, root, number, dry_run=False):
    before, original, disk_size = layout(disk, root)
    if dry_run:
        result = command("growpart", "--dry-run", disk, number, allowed=(0, 1))
        log(result.stdout.strip() or "partition already fills available space")
        return original["size"] * int(before["sectorsize"])
    end = (original["start"] + original["size"]) * int(before["sectorsize"])
    if disk_size - end >= 1024 * 1024:
        command("sgdisk", "--move-second-header", disk)
        probe = command("growpart", "--dry-run", disk, number, allowed=(0, 1))
        if probe.returncode == 0:
            log(command("growpart", disk, number).stdout.strip())
        else:
            log("partition already fills available space")
    else:
        log("no significant trailing space; checking filesystem size")
    after, current, _ = layout(disk, root)
    if after.get("id") != before.get("id"):
        raise RuntimeError("disk UUID changed unexpectedly")
    for entry in before["partitions"]:
        updated = next(p for p in after["partitions"] if p["node"] == entry["node"])
        expected = dict(entry)
        if entry == original:
            if updated["size"] < entry["size"]:
                raise RuntimeError("root partition unexpectedly shrank")
            expected["size"] = updated["size"]
        if updated != expected:
            raise RuntimeError("partition identity or unrelated partition changed unexpectedly")
    expected_size = current["size"] * int(after["sectorsize"])
    actual_size = int(command("blockdev", "--getsize64", root).stdout)
    if actual_size != expected_size:
        command("partx", "--update", "--nr", number, disk)
        actual_size = int(command("blockdev", "--getsize64", root).stdout)
        if actual_size != expected_size:
            raise RuntimeError("kernel has not accepted the new partition size; growth deferred until next boot")
    return actual_size


def grow_luks_partition(partition, dry_run):
    partition = os.path.realpath(partition)
    luks_metadata(partition)
    disk, number = partition_parent(partition)
    grow_partition(disk, partition, number, dry_run)
    log("LUKS2 partition checked before unlock; opening it will use the full payload size")


def initrd_partition(name, cmdline):
    if name != "dcore-root":
        raise Skip("cryptsetup instance is not dcore's root")
    words = cmdline.split()
    if [word for word in words if word.startswith("root=")] != ["root=/dev/mapper/dcore-root"]:
        raise Skip("kernel root does not use the dcore-root mapping")
    uuids = [word.removeprefix("rd.luks.name=").removesuffix("=dcore-root")
             for word in words if word.startswith("rd.luks.name=") and word.endswith("=dcore-root")]
    if len(uuids) != 1 or not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", uuids[0]):
        raise Skip("root LUKS UUID cannot be identified unambiguously")
    return f"/dev/disk/by-uuid/{uuids[0]}"


def grow(dry_run):
    result = command("findmnt", "--json", "--mountpoint", "/sysroot", "--output", "SOURCE,FSTYPE,OPTIONS,MAJ:MIN", allowed=(0, 1))
    if result.returncode == 1:
        raise Skip("/sysroot is not a mount point")
    mounts = json.loads(result.stdout).get("filesystems", [])
    if len(mounts) != 1:
        raise Skip("root mount cannot be identified unambiguously")
    mount = mounts[0]
    filesystem = mount["fstype"]
    if filesystem not in ("ext4", "btrfs", "xfs"):
        raise Skip(f"unsupported backing filesystem: {filesystem}")
    root = root_device(mount)
    partition, holder = backing_partition(root)
    disk, number = partition_parent(partition, holder)
    before, original, disk_size = layout(disk, partition)
    if holder and disk_size - (original["start"] + original["size"]) * int(before["sectorsize"]) >= 1024 * 1024:
        raise Skip("encrypted partition has trailing space; reboot to grow it before unlock")
    devid = btrfs_device("/sysroot", root) if filesystem == "btrfs" else None
    log(f"backing root is {root}, {filesystem}, partition {number} on {disk}")
    if dry_run:
        result = command("growpart", "--dry-run", disk, number, allowed=(0, 1))
        log(result.stdout.strip() or "partition already fills available space")
        log(f"would ensure {filesystem} fills the partition; no disk changes made")
        return

    # A writable bind in a private namespace preserves host mount flags and
    # /usr's read-only composefs mount. Prove it is writable before editing GPT.
    writable = tempfile.mkdtemp(prefix="dcore-grow-root-", dir="/run")
    try:
        command("mount", "--bind", "/sysroot", writable)
        try:
            command("mount", "-o", "remount,bind,rw", writable)
            actual_size = (int(command("blockdev", "--getsize64", root).stdout) if holder
                           else grow_partition(disk, partition, number))
            # Always retry filesystem growth, including after a prior interrupted
            # run that enlarged the partition but left the filesystem unchanged.
            if filesystem == "ext4":
                # resize2fs selects the first matching mount, not our writable
                # alias. Change it only inside this private mount namespace.
                readonly = "ro" in mount["options"].split(",")
                if readonly:
                    command("mount", "-o", "remount,bind,rw", "/sysroot")
                try:
                    output = command("resize2fs", root)
                finally:
                    if readonly:
                        command("mount", "-o", "remount,bind,ro", "/sysroot")
            elif filesystem == "btrfs":
                output = command("btrfs", "filesystem", "resize", f"{devid}:max", writable)
            else:
                output = command("xfs_growfs", "-d", writable)
            log(output.stdout.strip() or output.stderr.strip() or "filesystem already fills partition")
            log(f"complete: root partition is {actual_size} bytes; original mount permissions preserved")
        finally:
            command("umount", writable)
    finally:
        # Never recursively remove a mount point if unmounting failed.
        try:
            os.rmdir(writable)
        except OSError:
            log(f"temporary mount directory retained: {writable}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="inspect partition growth without changing disks")
    parser.add_argument("--private-namespace", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--luks-partition", help=argparse.SUPPRESS)
    parser.add_argument("--initrd-luks-root", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if os.geteuid() != 0:
        parser.error("run as root")
    if not args.dry_run and not args.private_namespace and not (args.luks_partition or args.initrd_luks_root):
        # Isolate manual runs too, so a killed process cannot leave host mounts
        # writable. The service additionally sets PrivateMounts=yes.
        os.execvp("unshare", ["unshare", "--mount", "--propagation", "private",
                              os.path.realpath(__file__), "--private-namespace"])
    # Serialize manual invocations with the boot service.
    with open("/run/dcore-grow-root.lock", "w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cmdline = Path("/proc/cmdline").read_text()
            if "dcore.grow-root=0" in cmdline.split():
                raise Skip("disabled by dcore.grow-root=0")
            if args.initrd_luks_root:
                grow_luks_partition(initrd_partition(args.initrd_luks_root, cmdline), args.dry_run)
            elif args.luks_partition:
                grow_luks_partition(args.luks_partition, args.dry_run)
            else:
                grow(args.dry_run)
        except Skip as error:
            log(f"skipped: {error}")
        except (RuntimeError, OSError, ValueError, KeyError, StopIteration) as error:
            log(f"failed: {error}; normal boot may continue; retry after correcting the problem")
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

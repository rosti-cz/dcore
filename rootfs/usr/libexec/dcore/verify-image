#!/usr/bin/env bash
set -euo pipefail
bootc container lint --fatal-warnings
ostree --version | grep -q composefs
systemd-analyze verify --man=no /usr/lib/systemd/system/dcore-update.service /usr/lib/systemd/system/dcore-update.timer /usr/lib/systemd/system/dcore-grow-root.service /usr/lib/systemd/system/dcore-homebrew.service /usr/lib/systemd/system/dcore-network-bootstrap.service
mapfile -t kernels < <(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
[[ ${#kernels[@]} == 1 ]]
kernel=${kernels[0]}
test -s "/usr/lib/modules/${kernel}/vmlinuz"
test -s "/usr/lib/modules/${kernel}/initramfs.img"
modinfo -k "$kernel" zfs > /dev/null
initramfs="/usr/lib/modules/${kernel}/initramfs.img"
modules=$(lsinitrd -m "$initramfs")
for module in bootc ostree zfs crypt systemd-cryptsetup tpm2-tss dcore-grow-root; do
    grep -qx "$module" <<< "$modules"
done
grow_hook=$(lsinitrd -f usr/lib/systemd/system/dcore-grow-luks-root.service "$initramfs")
grep -q -- '--initrd-luks-root dcore-root' <<< "$grow_hook"
root_config=$(lsinitrd -f usr/lib/ostree/prepare-root.conf "$initramfs")
grep -q 'enabled = yes' <<< "$root_config"
for unit in systemd-timesyncd.service fstrim.timer dcore-grow-root.service dcore-homebrew.service dcore-network-bootstrap.service; do
    [[ $(systemctl --root=/ is-enabled "$unit") == enabled ]]
done
for unit in dcore-update.timer bootc-fetch-apply-updates.timer bootc-fetch-updates.timer apt-daily.timer apt-daily-upgrade.timer; do
    if systemctl --root=/ is-enabled "$unit" > /dev/null 2>&1; then
        echo "Unexpected enabled update timer: $unit" >&2; exit 1
    fi
done
# OVS starts only when explicitly configured.
for unit in openvswitch-switch.service ovsdb-server.service ovs-vswitchd.service; do
    state=$(systemctl --root=/ is-enabled "$unit" 2>/dev/null || true)
    [[ $state == disabled || $state == static ]]
done
for tool in ip networkctl hostnamectl just djust tpm2 systemd-cryptenroll cryptsetup fish fastfetch fzf locale localectl update-locale timedatectl smartctl smartd htop vim nmap git tmux wget curl jq unzip iotop ncdu parted rsync http batcat rg tracepath duf docker rclone incus zfs btrfs growpart sgdisk resize2fs xfs_growfs sfdisk partx findmnt unshare distrobox distrobox-create newuidmap newgidmap slirp4netns fuse-overlayfs pasta ovs-vsctl ovs-vswitchd brew bootc; do
    command -v "$tool" > /dev/null
done
test -x /usr/libexec/incus/incus-agent
test -x /usr/libexec/incus/incus-agent-setup
test -s /usr/lib/udev/rules.d/60-incus-agent.rules
systemd-analyze verify --man=no incus-agent.service
grep -qx 'ExecStart=/usr/libexec/dcore/incus-agent' /usr/lib/systemd/system/incus-agent.service.d/10-host-agent.conf
for unit in incus.socket incus-startup.service incus-lxcfs.service; do
    [[ $(systemctl --root=/ is-enabled "$unit" 2>/dev/null || true) == disabled ]]
done
just --justfile /usr/share/dcore/justfile --list
for tool in admin admin-privileged install/block_install install/lib/check-block-device.py install/lib/install-encrypted.py install/lib/finish-install.py installer/dcore-installer installer/host-backend.py installer/checks.py network-bootstrap; do
    test -f "/usr/libexec/dcore/$tool"
done
test -x /usr/libexec/dcore/grow-root
test -s /usr/share/dcore/homebrew-seed.tar.zst
getent passwd core > /dev/null
for account in root core; do
    [[ $(getent passwd "$account" | cut -d: -f7) == /usr/bin/fish ]]
done
visudo --check
dpkg-query -W cryptsetup systemd-cryptsetup distrobox uidmap openvswitch-switch openvswitch-common build-essential cloud-guest-utils gdisk btrfs-progs incus-agent zfs-dkms zfsutils-linux incus docker.io docker-compose systemd-timesyncd > /dev/null
incus --version
LD_LIBRARY_PATH=/opt/incus/lib /opt/incus/bin/incusd --version
LD_LIBRARY_PATH=/opt/incus/lib "/opt/incus/bin/qemu-system-$(uname -m)" --version
docker compose version
fastfetch --version
fastfetch --logo none --pipe true | grep -E '^OS: .*Debian.*\(dcore\)$'
/usr/libexec/dcore/installer/dcore-installer --version
/usr/libexec/dcore/verify-secureboot
test -x /usr/libexec/dcore/bootctl.real
test "$(readlink /usr/bin/bootctl)" = /usr/libexec/dcore/bootctl-shim
locale -a | grep -qx 'en_US.utf8'
locale -a | grep -qx 'cs_CZ.utf8'
test -s /usr/share/zoneinfo/Europe/Prague

distrobox --version
ovs-vsctl --version

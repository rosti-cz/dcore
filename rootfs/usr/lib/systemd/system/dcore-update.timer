[Unit]
Description=Weekly bootc image update and automatic reboot
# Trigger on either supported bootc backend; skip ordinary containers.
ConditionPathExists=|/run/ostree-booted
ConditionKernelCommandLine=|composefs
ConditionKernelCommandLine=|composefs.digest

[Timer]
OnCalendar=Sun *-*-* 04:00:00
RandomizedDelaySec=1h
Persistent=true
Unit=dcore-update.service

[Install]
WantedBy=timers.target

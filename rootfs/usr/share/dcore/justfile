set shell := ["/bin/sh", "-eu", "-c"]

# List dcore administration commands.
default:
    @/usr/bin/just --justfile /usr/share/dcore/justfile --list

# Enroll TPM2 automatic unlocking for the LUKS2 system disk.
enroll-tpm:
    @/usr/libexec/dcore/admin enroll-tpm

# Request dcore certificate enrollment; confirm it in MokManager on reboot.
enroll-secureboot:
    @/usr/libexec/dcore/admin enroll-secureboot

# Upgrade the OS and Homebrew; choose "homebrew" or "os" to retry one part.
upgrade component="all":
    @/usr/libexec/dcore/admin upgrade --component {{quote(component)}}

# Install with the shared Go terminal/web wizard; 'plain' uses key-based prompts.
install interface="tui":
    @/usr/libexec/dcore/admin install --interface {{quote(interface)}}

# Generate an Ed25519 SSH key for core, preserving an existing key.
gen-sshkey:
    @/usr/libexec/dcore/admin gen-sshkey

# Choose and approve a weekly image-update and reboot schedule.
enable-autoupgrade:
    @/usr/libexec/dcore/admin enable-autoupgrade

# Enable one-shot rollback protection for automatic OS updates.
enable-autorollback:
    @/usr/libexec/dcore/admin enable-autorollback

# Enable the Incus server, or offer to disable it if already enabled.
enable-incus:
    @/usr/libexec/dcore/admin enable-incus

# Select and apply the system locale with fzf; takes effect on the next login.
switch-locale:
    @/usr/libexec/dcore/admin switch-locale

# Select and apply the system timezone with fzf.
set-timezone:
    @/usr/libexec/dcore/admin set-timezone

# Set the system hostname; Enter cancels without changes.
set-hostname:
    @/usr/libexec/dcore/admin set-hostname

# Change the root LUKS2 password while preserving TPM enrollment.
change-luks-password:
    @/usr/libexec/dcore/admin change-luks-password

# Toggle the current user's automatic login banner without sudo.
hush-banner:
    @/usr/libexec/dcore/admin hush-banner
